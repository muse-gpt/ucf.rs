{
    "name": "@ucf/unknown-wasm32",
    "version": "0.0.0",
    "description": "UCF Wasm platform bag (wasm32-unknown-unknown) for browser / Node",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "ucf_wasm_bg.wasm",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "build:wasm": "cargo build -p ucf-wasm --manifest-path ../../../../Cargo.toml --target wasm32-unknown-unknown --release && node ./scripts/copy-from-cargo.mjs",
        "copy:wasm": "node ./scripts/copy-from-cargo.mjs"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.7.0"
    },
    "engines": {
        "node": ">=18"
    },
    "license": "MPL-2.0",
    "keywords": [
        "ucf",
        "wasm",
        "wasm32",
        "webassembly"
    ],
    "publish": false
}
